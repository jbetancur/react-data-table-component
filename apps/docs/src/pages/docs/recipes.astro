---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { recipes } from '../../data/nav';
---

<DocsLayout title="Recipes | react-data-table-component" description="Copy-paste recipes for common react-data-table-component patterns: bulk actions, server-side data, editable grids, and more.">
  <h1>Recipes</h1>

  <p>
    Working patterns for common product needs. Each recipe is self-contained: copy into your
    project and adjust.
  </p>

  <div class="not-prose mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {recipes.map(({ href, label, description }) => (
      <a
        href={href}
        class="block rounded-xl border border-gray-100 p-5 hover:border-brand-200 hover:shadow-sm transition-all group"
      >
        <div class="font-semibold text-gray-900 group-hover:text-brand-600 transition-colors">
          {label} →
        </div>
        <p class="mt-1 text-sm text-gray-500">{description}</p>
      </a>
    ))}
  </div>
</DocsLayout>
