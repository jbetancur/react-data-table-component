---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import DocsTable from '../../components/DocsTable.astro';
import InstallTabs from '../../components/InstallTabs.astro';
---

<DocsLayout title="Installation | react-data-table-component" description="Install react-data-table-component with npm, yarn, pnpm, or bun. Works with React 18+, Next.js App Router, Vite, and Remix.">
  <h1>Installation</h1>

  <p>Install the package with your package manager:</p>

  <InstallTabs />

  <h2>Requirements</h2>

  <DocsTable
    headers={['Peer dependency', 'Version']}
    rows={[
      ['<code>react</code>', '<code>&gt;=18.0.0</code>'],
      ['<code>react-dom</code>', '<code>&gt;=18.0.0</code>'],
    ]}
  />

  <p>
    React 17 is not supported. React 18 concurrent features (<code>useTransition</code>,
    <code>useId</code>) are used internally.
  </p>

  <h2>No CSS import needed</h2>

  <p>
    Styles are injected automatically when the component first renders. You do not need
    to import any CSS file in standard React apps (Vite, CRA, Remix, etc.).
  </p>

  <p>
    If you render on the server and want styles in the initial HTML, import the stylesheet
    once at the root of your app, for example in a Next.js App Router <code>layout.tsx</code>:
  </p>

  <CodeBlock code={`import 'react-data-table-component/css';`} lang="ts" />

  <h2>TypeScript</h2>

  <p>
    Type declarations are bundled. No <code>@types/</code> package required.
    All public types are re-exported from the main entry point:
  </p>

  <CodeBlock code={`import DataTable, { type TableColumn, type TableProps } from 'react-data-table-component';`} lang="ts" />

  <h2>Framework notes</h2>

  <DocsTable
    headers={['Framework', 'Notes']}
    rows={[
      ['Vite / Create React App', 'Works out of the box'],
      ['Next.js App Router', 'Import <code>&lt;DataTable&gt;</code> directly from any file. The bundle ships with <code>"use client"</code>.'],
      ['Next.js Pages Router', 'Works out of the box'],
      ['Remix', 'Works out of the box'],
      ['Astro', 'Use <code>client:load</code> or <code>client:visible</code> directive'],
    ]}
  />

  <p>
    See <a href="/docs/ssr">SSR</a> for a full example in each framework.
  </p>
</DocsLayout>
