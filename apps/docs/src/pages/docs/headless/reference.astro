import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import DocsTable from '../../../components/DocsTable.astro';
---

<DocsLayout title="Headless hook reference | react-data-table-component" description="Signatures, options, defaults, and return values for the headless hooks and pinning helpers in react-data-table-component.">

  <h1>Hook reference</h1>

  <p>
    Signatures, options, and return values for everything exported from
    <code>react-data-table-component/headless</code>. For what the hooks are and how they fit together,
    start with the <a href="/docs/headless">Headless overview</a>. For a complete styled table,
    see <a href="/docs/headless/tailwind">Headless table with Tailwind</a>.
  </p>

  <CodeBlock lang="ts" code={`import {
  useColumns,
  useTableState,
  useTableData,
  useColumnFilter,
  useColumnVisibility,
  useColumnResize,
  useCellNavigation,
  useTableExport,
  getPinnedOffsets,
  getPinnedTotalWidths,
  getPinnedCellMeta,
} from 'react-data-table-component/headless';`} />

  <p>
    Option and result types are exported under matching names, such as <code>UseTableStateProps</code> and
    <code>UseTableStateReturn</code>. See <a href="/docs/typescript">TypeScript</a> for the full
    list. <code>useColumnVisibility</code> is documented on
    the <a href="/docs/column-visibility">Column visibility</a> page.
  </p>

  <h2><code>useColumns&lt;T&gt;</code></h2>

  <CodeBlock lang="ts" code={`function useColumns<T>(
  columns: TableColumn<T>[],
  options?: {
    onColumnOrderChange?: (nextOrder: TableColumn<T>[]) => void;
    onColumnGroupOrderChange?: (nextGroups: ColumnGroup[], nextColumns: TableColumn<T>[]) => void;
    columnGroups?: ColumnGroup[];
    defaultSortFieldId?: string | number | null;
    defaultSortAsc?: boolean; // default true
  },
): UseColumnsResult<T>;`} />

  <p>
    Every option is optional. <code>columnGroups</code> and <code>onColumnGroupOrderChange</code> only matter
    if you're using <a href="/docs/column-groups">column groups</a>. The positional form
    <code>useColumns(columns, onColumnOrderChange, onColumnGroupOrderChange, columnGroups, defaultSortFieldId, defaultSortAsc)</code>
    still works.
  </p>

  <DocsTable
    headers={['Property', 'Type', 'Description']}
    rows={[
      ['<code>tableColumns</code>', '<code>TableColumn&lt;T&gt;[]</code>', 'Decorated columns in current order'],
      ['<code>tableGroups</code>', '<code>ColumnGroup[]</code>', 'Column groups in current order'],
      ['<code>defaultSortColumn</code>', '<code>TableColumn&lt;T&gt;</code>', 'The column matching <code>defaultSortFieldId</code>. Pass it to <code>useTableState</code>'],
      ['<code>defaultSortDirection</code>', '<code>SortOrder</code>', '<code>\'asc\'</code> or <code>\'desc\'</code> from <code>defaultSortAsc</code>'],
      ['<code>columnDrag</code>', '<code>ColumnDragSlice</code>', 'Drag-to-reorder event handlers (see below)'],
      ['<code>draggingColumnId</code>', '<code>string</code>', 'ID of the column being dragged, or <code>\'\'</code>'],
      ['<code>draggingGroupKey</code>', '<code>string</code>', 'Key of the group being dragged, or <code>\'\'</code>'],
      ['<code>handlePinColumn</code>', '<code>(columnId, side?: \'left\' | \'right\') =&gt; void</code>', 'Pin a column to a side, or unpin it by omitting <code>side</code>'],
      ['<code>handleHideColumn</code>', '<code>(columnId) =&gt; void</code>', 'Set <code>omit: true</code> on a column'],
      ['<code>handleResetColumns</code>', '<code>() =&gt; void</code>', 'Restore the original order, pins, and visibility'],
    ]}
  />

  <p>
    For drag-to-reorder, give each header cell a <code>data-column-id</code> attribute and
    <code>draggable</code>, then attach the handlers from <code>columnDrag</code>. The hook reads the column
    id from that attribute.
  </p>

  <CodeBlock lang="tsx" code={`const { tableColumns, columnDrag, draggingColumnId } = useColumns(columns);

{tableColumns.map(col => (
  <th
    key={col.id}
    data-column-id={col.id}
    draggable
    onDragStart={columnDrag.onDragStart}
    onDragEnter={columnDrag.onDragEnter}
    onDragOver={columnDrag.onDragOver}
    onDragLeave={columnDrag.onDragLeave}
    onDragEnd={columnDrag.onDragEnd}
    onPointerDown={columnDrag.onPointerDown} // touch and pen
    style={{ opacity: draggingColumnId === String(col.id) ? 0.5 : 1 }}
  >
    {col.name}
  </th>
))}`} />

  <p>
    All five drag handlers must be attached for mouse reordering to work. <code>onPointerDown</code> adds
    long-press reordering on touch and pen. The <code>onGroup*</code> handlers in the same object do the
    same for group header cells, keyed by a <code>data-group-key</code> attribute.
  </p>

  <h2><code>useTableState&lt;T&gt;</code></h2>

  <CodeBlock lang="ts" code={`function useTableState<T>(props: UseTableStateProps<T>): UseTableStateReturn<T>;`} />

  <p>
    Only <code>data</code> is required. <code>UseTableStateProps</code> and <code>UseTableStateReturn</code>
    are exported types.
  </p>

  <p><strong>Props:</strong></p>

  <DocsTable
    headers={['Prop', 'Type', 'Default', 'Description']}
    rows={[
      ['<code>data</code>', '<code>T[]</code>', 'required', 'Full dataset (used for selection total counts)'],
      ['<code>keyField</code>', '<code>string</code>', '<code>\'id\'</code>', 'Unique row identifier field'],
      ['<code>defaultSortColumn</code>', '<code>TableColumn&lt;T&gt;</code>', 'no sort', 'Column active on first render, from <code>useColumns</code>'],
      ['<code>defaultSortDirection</code>', '<code>SortOrder</code>', '<code>\'asc\'</code>', '<code>\'asc\'</code> | <code>\'desc\'</code>'],
      ['<code>pagination</code>', '<code>boolean</code>', '<code>false</code>', 'Only affects page recalculation in server mode. Page state is always tracked'],
      ['<code>paginationDefaultPage</code>', '<code>number</code>', '<code>1</code>', 'Starting page (1-based)'],
      ['<code>paginationPerPage</code>', '<code>number</code>', '<code>10</code>', 'Rows per page'],
      ['<code>paginationPage</code>', '<code>number</code>', '', 'Controlled current page'],
      ['<code>paginationServer</code>', '<code>boolean</code>', '<code>false</code>', 'Skip internal page math'],
      ['<code>paginationServerOptions</code>', '<code>PaginationServerOptions</code>', '<code>{}</code>', '<code>persistSelectedOnPageChange</code>, <code>persistSelectedOnSort</code>'],
      ['<code>paginationTotalRows</code>', '<code>number</code>', '<code>0</code>', 'Total server rows (server mode only)'],
      ['<code>paginationResetDefaultPage</code>', '<code>boolean</code>', '<code>false</code>', 'Toggle to reset to page 1'],
      ['<code>selectableRowsSingle</code>', '<code>boolean</code>', '<code>false</code>', 'Allow only one selected row'],
      ['<code>selectableRowsVisibleOnly</code>', '<code>boolean</code>', '<code>false</code>', '"Select all" acts on current page only'],
      ['<code>selectableRowSelected</code>', '<code>(row: T) =&gt; boolean | null</code>', '<code>null</code>', 'Pre-select matching rows'],
      ['<code>controlledSelectedRows</code>', '<code>T[]</code>', '', 'Controlled selection. Overrides internal selection state'],
      ['<code>clearSelectedRows</code>', '<code>boolean</code>', '<code>false</code>', 'Toggle to clear selection'],
      ['<code>onSelectedRowsChange</code>', '<code>(state) =&gt; void</code>', '', 'Fires on any selection change'],
      ['<code>onChangePage</code>', '<code>(page, total) =&gt; void</code>', '', 'Fires after page changes'],
      ['<code>onChangeRowsPerPage</code>', '<code>(perPage, page) =&gt; void</code>', '', 'Fires after rows-per-page changes'],
    ]}
  />

  <p>
    To hear about sort changes, pass <code>onSort</code> to <code>useTableData</code>, which is the hook
    that holds the sorted rows.
  </p>

  <p><strong>Returns:</strong></p>

  <DocsTable
    headers={['Property', 'Type', 'Description']}
    rows={[
      ['<code>tableState</code>', '<code>TableState&lt;T&gt;</code>', 'Full state snapshot (see below)'],
      ['<code>handleSort</code>', '<code>(action: SortAction&lt;T&gt;) =&gt; void</code>', 'Dispatch a sort change'],
      ['<code>handleSelectAllRows</code>', '<code>(action: AllRowsAction&lt;T&gt;) =&gt; void</code>', 'Dispatch select/deselect all'],
      ['<code>handleSelectedRow</code>', '<code>(action: SingleRowAction&lt;T&gt;) =&gt; void</code>', 'Dispatch a single row toggle'],
      ['<code>handleSelectedRange</code>', '<code>(action: RangeRowAction&lt;T&gt;) =&gt; void</code>', 'Dispatch a Shift-click range selection'],
      ['<code>handleChangePage</code>', '<code>(page: number) =&gt; void</code>', 'Dispatch a page change'],
      ['<code>handleChangeRowsPerPage</code>', '<code>(perPage, rowCount) =&gt; void</code>', 'Dispatch a per-page change'],
      ['<code>handleClearSelectedRows</code>', '<code>() =&gt; void</code>', 'Programmatically clear all selections'],
      ['<code>handleClearSort</code>', '<code>() =&gt; void</code>', 'Programmatically reset sort to the default'],
    ]}
  />

  <p>
    <code>SortAction&lt;T&gt;</code> is <code>&#123; type: 'SORT_CHANGE', selectedColumn: TableColumn&lt;T&gt;,
    clearSelectedOnSort: boolean, additive: boolean, defaultSortDirection: SortOrder &#125;</code>.
    <code>additive: true</code> adds the column to the existing sort instead of replacing it (multi-column
    sort); most callers pass <code>false</code>. Add <code>direction: SortOrder</code> to force a direction
    instead of cycling.
  </p>

  <p>
    Selection uses the same pattern: build a <code>SELECT_SINGLE_ROW</code>, <code>SELECT_ALL_ROWS</code>, or
    <code>SELECT_RANGE</code> action. The action types (<code>SortAction</code>, <code>SingleRowAction</code>,
    <code>AllRowsAction</code>, <code>RangeRowAction</code>) and <code>TableState</code> are exported.
  </p>

  <CodeBlock lang="tsx" code={`const { tableState, handleSelectedRow } = useTableState({ data });
const isSelected = (row: Person) => tableState.selectedRows.some(r => r.id === row.id);

<input
  type="checkbox"
  checked={isSelected(row)}
  onChange={() =>
    handleSelectedRow({
      type: 'SELECT_SINGLE_ROW',
      keyField: 'id',
      row,
      isSelected: isSelected(row), // the state before this click
      rowCount: data.length,
      singleSelect: false,
    })
  }
/>`} />

  <p><strong><code>TableState&lt;T&gt;</code> shape:</strong></p>

  <DocsTable
    headers={['Field', 'Type']}
    rows={[
      ['<code>currentPage</code>', '<code>number</code>'],
      ['<code>rowsPerPage</code>', '<code>number</code>'],
      ['<code>selectedColumn</code>', '<code>TableColumn&lt;T&gt;</code>'],
      ['<code>sortDirection</code>', '<code>SortOrder</code>'],
      ['<code>sortColumns</code>', '<code>SortColumn&lt;T&gt;[]</code>: full sort config in priority order; required by <code>useTableData</code>'],
      ['<code>selectedRows</code>', '<code>T[]</code>'],
      ['<code>selectedCount</code>', '<code>number</code>'],
      ['<code>allSelected</code>', '<code>boolean</code>'],
    ]}
  />

  <h2><code>useTableData&lt;T&gt;</code></h2>

  <CodeBlock lang="ts" code={`function useTableData<T>(props: UseTableDataProps<T>): UseTableDataReturn<T>;`} />

  <DocsTable
    headers={['Prop', 'Type', 'Default', 'Description']}
    rows={[
      ['<code>data</code>', '<code>T[]</code>', 'required', 'Source rows (full array for client-side; current-page array for server-side)'],
      ['<code>selectedColumn</code>', '<code>TableColumn&lt;T&gt;</code>', 'required', 'From <code>tableState.selectedColumn</code>'],
      ['<code>sortDirection</code>', '<code>SortOrder</code>', 'required', 'From <code>tableState.sortDirection</code>'],
      ['<code>sortColumns</code>', '<code>SortColumn&lt;T&gt;[]</code>', 'required', 'From <code>tableState.sortColumns</code>'],
      ['<code>currentPage</code>', '<code>number</code>', 'required', 'From <code>tableState.currentPage</code>'],
      ['<code>rowsPerPage</code>', '<code>number</code>', 'required', 'From <code>tableState.rowsPerPage</code>'],
      ['<code>pagination</code>', '<code>boolean</code>', '<code>false</code>', 'Slice <code>tableRows</code> to the current page'],
      ['<code>paginationServer</code>', '<code>boolean</code>', '<code>false</code>', 'Skip page slicing (server already paginated)'],
      ['<code>sortServer</code>', '<code>boolean</code>', '<code>false</code>', 'Skip sorting (server already sorted)'],
      ['<code>sortFunction</code>', '<code>SortFunction&lt;T&gt; | null</code>', '<code>null</code>', 'Global custom sort comparator'],
      ['<code>onSort</code>', '<code>(col, dir, rows, sortColumns) =&gt; void</code>', '', 'Called after sort; receives sorted rows'],
    ]}
  />

  <DocsTable
    headers={['Property', 'Type', 'Description']}
    rows={[
      ['<code>sortedData</code>', '<code>T[]</code>', 'All rows after sorting (full dataset, pre-slice)'],
      ['<code>tableRows</code>', '<code>T[]</code>', 'With <code>pagination: true</code>, the current page of <code>sortedData</code>. Otherwise the same rows as <code>sortedData</code>'],
    ]}
  />

  <p>
    When you also filter, pass <code>sortedData</code> (not a paginated <code>tableRows</code>) to
    <code>useColumnFilter</code>'s <code>filteredData()</code> and slice the page afterwards. See
    <a href="/docs/headless#filter-before-you-paginate">Filter before you paginate</a>.
  </p>

  <h2><code>useColumnFilter&lt;T&gt;</code></h2>

  <CodeBlock lang="ts" code={`import type { FilterState } from 'react-data-table-component';

function useColumnFilter<T>(
  columns: TableColumn<T>[],
  options?: {
    filterValues?: Record<string | number, FilterState>;
    onFilterChange?: (columnId: string | number, filter: FilterState) => void;
    localization?: Localization['filter'];
    rows?: T[];
  },
): UseColumnFilterResult<T>;`} />

  <p>
    Omit <code>filterValues</code> and <code>onFilterChange</code> to run in <strong>uncontrolled</strong> mode
    (internal state). Pass both to run in <strong>controlled</strong> mode (you own the state).
  </p>

  <p>
    Pass <code>rows</code> when any column uses <code>filterType: 'set'</code>. That is the row array the checklist
    derives its distinct values from, so without it a set filter opens an empty list. Every other filter type ignores
    it.
  </p>

  <blockquote>
    The older positional form <code>useColumnFilter(columns, filterValues, onFilterChange)</code> still works and is
    deprecated. It cannot supply <code>rows</code>, so set filters need the options object. The positional form is
    removed in v9.
  </blockquote>

  <DocsTable
    headers={['Property', 'Type', 'Description']}
    rows={[
      ['<code>filterValues</code>', '<code>Record&lt;string | number, FilterState&gt;</code>', 'Current filter state per column ID'],
      ['<code>handleFilterChange</code>', '<code>(columnId, filter) =&gt; void</code>', 'Call this when the user applies a filter'],
      ['<code>filteredData</code>', '<code>(data: T[]) =&gt; T[]</code>', 'Apply all active filters to a row array'],
    ]}
  />

  <p>
    <code>filteredData</code> is a stable memoized function, safe to call in render.
    Each column can define <code>filterFunction: (row: T, filter: FilterState) =&gt; boolean</code> to
    override the built-in operator logic. See <a href="/docs/filtering">Filtering</a> for the full
    <code>FilterState</code> type and operator reference.
  </p>

  <h2><code>useCellNavigation&lt;T&gt;</code></h2>

  <p>
    Powers the WAI-ARIA grid pattern behind <code>cellNavigation</code>: arrow keys, <code>Home</code>/<code>End</code>,
    <code>Ctrl+Home</code>/<code>Ctrl+End</code>, and a roving tabindex. It reads and writes plain
    <code>data-nav-row</code> / <code>data-nav-col</code> attributes on your own cells. It doesn't know or
    care what markup they're attached to.
  </p>

  <CodeBlock lang="ts" code={`function useCellNavigation<T>(options: UseCellNavigationOptions<T>): {
  activeCell: ActiveCell | null;
  handleNavFocus: (e: React.FocusEvent<HTMLDivElement>) => void;
  handleNavKeyDown: (e: React.KeyboardEvent<HTMLDivElement>) => void;
};`} />

  <DocsTable
    headers={['Option', 'Type', 'Description']}
    rows={[
      ['<code>effectiveColumns</code>', '<code>TableColumn&lt;T&gt;[]</code>', 'Required. Your current column list. Columns with <code>omit: true</code> are excluded from the nav grid.'],
      ['<code>filteredTableRowCount</code>', '<code>number</code>', 'Required. Row count for the currently visible page. Clamps <code>ArrowDown</code>/<code>End</code>.'],
      ['<code>cellNavigation</code>', '<code>boolean</code>', 'Master on/off switch, default <code>true</code>. When <code>false</code>, <code>activeCell</code> is always <code>null</code>.'],
      ['<code>showTableHead</code>', '<code>boolean</code>', 'Whether a header row participates in the grid (row <code>-1</code>), default <code>true</code>. <code>false</code> removes header cells from the tab sequence entirely.'],
      ['<code>selectableRows</code>', '<code>boolean</code>', 'Reserves nav column 0 for a selection checkbox, if you render one. Default <code>false</code>.'],
      ['<code>expandableRows</code>', '<code>boolean</code>', 'Reserves the next nav column for an expander button, if you render one. Default <code>false</code>.'],
      ['<code>expandableRowsHideExpander</code>', '<code>boolean</code>', 'Skip the expander column reservation even when <code>expandableRows</code> is true. Default <code>false</code>.'],
    ]}
  />

  <p>
    The hook supplies focus movement only. Set <code>role="grid"</code>, <code>role="row"</code>, and
    <code>role="gridcell"</code> (or use native table elements) on your own markup.
  </p>

  <p>
    Wire it up by spreading <code>data-nav-row</code>/<code>data-nav-col</code> (row <code>-1</code> for the
    header) onto each focusable cell, setting <code>tabIndex</code> from <code>activeCell</code>, and
    attaching <code>onFocus</code>/<code>onKeyDown</code> to the table root:
  </p>

  <CodeBlock lang="tsx" code={`function Row({ row, rowIndex, columns, activeCell }) {
  return (
    <tr>
      {columns.map((col, colIndex) => (
        <td
          key={col.id}
          data-nav-row={rowIndex}
          data-nav-col={colIndex}
          tabIndex={activeCell?.row === rowIndex && activeCell?.col === colIndex ? 0 : -1}
        >
          {col.selector?.(row, rowIndex)}
        </td>
      ))}
    </tr>
  );
}

function MyTable({ data, columns }) {
  const { activeCell, handleNavFocus, handleNavKeyDown } = useCellNavigation({
    effectiveColumns: columns,
    filteredTableRowCount: data.length,
    showTableHead: false, // this table renders no header row
  });

  return (
    <table onFocus={handleNavFocus} onKeyDown={handleNavKeyDown}>
      <tbody>
        {data.map((row, i) => (
          <Row key={row.id} row={row} rowIndex={i} columns={columns} activeCell={activeCell} />
        ))}
      </tbody>
    </table>
  );
}`} />

  <p>
    Cells that hold an interactive widget instead of plain text (a checkbox, an expander button) should
    also set <code>data-nav-widget="true"</code>, and the hook then focuses the widget itself rather than
    the cell wrapper, so <kbd>Space</kbd>/<kbd>Enter</kbd> activate it natively. See
    <a href="/docs/keyboard-navigation">Keyboard navigation</a> for the full key reference this
    reproduces.
  </p>

  <h2><code>useColumnResize</code></h2>

  <CodeBlock lang="ts" code={`function useColumnResize(options?: UseColumnResizeOptions): {
  columnWidths: Record<string | number, number>;
  handleResizeStart: (columnId: string | number, e: React.PointerEvent, minWidth?: string) => void;
};`} />

  <DocsTable
    headers={['Option', 'Type', 'Description']}
    rows={[
      ['<code>initialColumnWidths</code>', '<code>Record&lt;string | number, number&gt;</code>', 'Seed widths, e.g. hydrated from localStorage.'],
      ['<code>onColumnResize</code>', '<code>(columnId, width, allWidths) =&gt; void</code>', 'Fires on pointer release with the settled width.'],
      ['<code>isRTL</code>', '<code>boolean</code>', 'Invert the drag direction for right-to-left layouts.'],
    ]}
  />

  <p>
    Attach <code>handleResizeStart</code> to a drag handle's <code>onPointerDown</code>, inside a header cell
    that carries a <code>data-column-id</code> attribute (the hook measures that cell for the starting
    width). It tracks <code>pointermove</code>/<code>pointerup</code> on <code>document</code> itself, so
    you don't need to wire those up. The optional third argument is a CSS min width such as
    <code>'80px'</code>; the floor is 40px. Apply <code>columnWidths[column.id]</code> as an inline <code>width</code> on your header
    and body cells for that column.
  </p>

  <h2>Pinning: <code>getPinnedOffsets</code>, <code>getPinnedTotalWidths</code>, <code>getPinnedCellMeta</code></h2>

  <p>
    Column pinning has no hook. There's no state to own beyond <code>column.pinned</code> on your own
    column list. These are pure functions: given your columns and current widths, they compute sticky
    offsets and shadow metadata.
  </p>

  <CodeBlock lang="ts" code={`function getPinnedOffsets<T>(
  columns: TableColumn<T>[],
  columnWidths: Record<string | number, number>,
  selectableRows: boolean,
  expandableRows: boolean,
  expandableRowsHideExpander: boolean,
): PinnedOffsets;

function getPinnedTotalWidths<T>(
  columns: TableColumn<T>[],
  columnWidths: Record<string | number, number>,
  selectableRows: boolean,
  expandableRows: boolean,
  expandableRowsHideExpander: boolean,
): { left: number; right: number };

function getPinnedCellMeta<T>(
  column: TableColumn<T>,
  pinnedOffsets: PinnedOffsets | undefined,
  zIndex?: number,
): PinnedCellMeta;`} />

  <CodeBlock lang="tsx" code={`const pinnedOffsets = getPinnedOffsets(columns, columnWidths, false, false, false);

function Cell({ column, pinnedOffsets }: { column: TableColumn<Row>; pinnedOffsets: PinnedOffsets }) {
  const meta = getPinnedCellMeta(column, pinnedOffsets, 1);
  return (
    <td className={meta.className} style={meta.style}>
      {/* ... */}
    </td>
  );
}`} />

  <p>
    <code>getPinnedCellMeta</code> returns a <code>style</code> object (<code>position: 'sticky'</code>,
    the computed <code>left</code>/<code>right</code> offset, and <code>zIndex</code>) that's enough to
    render pinned columns on its own. <code>className</code> adds <code>rdt_pinLeftLast</code> /
    <code>rdt_pinRightFirst</code> on the pinned boundary's edge column. Those classes only draw a
    shadow if you import <code>react-data-table-component/css</code> (or match the selectors
    yourself); they're no-ops otherwise. See <a href="/docs/column-pinning">Column pinning</a> for the
    <code>column.pinned</code> API these functions read.
  </p>

  <h2><code>useTableExport</code></h2>

  <p>
    Generates CSV or JSON from any set of columns and rows. Pair it with
    <code>useTableData</code> and <code>useColumnFilter</code> to export exactly what the
    user sees (sorted, filtered, and paginated) rather than the raw dataset.
  </p>

  <CodeBlock lang="ts" code={`function useTableExport<T>(options: UseTableExportOptions<T>): UseTableExportResult;`} />

  <h3>Options</h3>

  <DocsTable
    headers={['Option', 'Type', 'Default', 'Description']}
    rows={[
      ['<code>columns</code>', '<code>TableColumn&lt;T&gt;[]</code>', 'required', 'Columns to include. Columns with <code>omit: true</code> are skipped automatically.'],
      ['<code>rows</code>', '<code>T[]</code>', 'required', 'Rows to export. Pass the filtered/sorted slice for "current view" semantics.'],
      ['<code>valueSource</code>', '<code>\'selector\' | \'format\'</code>', '<code>\'selector\'</code>', '<code>\'selector\'</code> exports raw values; <code>\'format\'</code> runs <code>column.format</code> first.'],
      ['<code>headerOverrides</code>', '<code>Record&lt;string | number, string&gt;</code>', '—', 'Override the header label for columns whose <code>name</code> is a React node.'],
      ['<code>columnOrder</code>', '<code>(string | number)[]</code>', '—', 'Restrict and reorder exported columns by id. Omit to include all visible columns.'],
    ]}
  />

  <h3>Return value</h3>

  <DocsTable
    headers={['Property', 'Type', 'Description']}
    rows={[
